param(
    [string]$OutputFolder = 'C:\Temp'
)

# =========================
# MODULES
# =========================
Import-Module Microsoft.Graph.Authentication -ErrorAction Stop
Import-Module Microsoft.Graph.Users -ErrorAction Stop
Import-Module Microsoft.Graph.Identity.SignIns -ErrorAction Stop
Import-Module Microsoft.Graph.Reports -ErrorAction Stop

$UseExcel = $false
try {
    if (Get-Module -ListAvailable -Name ImportExcel) {
        Import-Module ImportExcel -ErrorAction Stop
        $UseExcel = $true
    }
}
catch {
    $UseExcel = $false
}

# =========================
# CONSTANTS
# =========================
$script:PhoneTypeMap = @{
    '3179e48a-750b-4051-897c-87b9720928f7' = 'mobile'
    'b6332ec1-7057-4abe-9331-3d72feddfe41' = 'alternateMobile'
    'e37fc753-ff3b-4958-9484-eaa9425c82bc' = 'office'
}

# =========================
# CONNECTION FUNCTIONS
# =========================
function Disconnect-GraphSession {
    try {
        if (Get-MgContext) {
            Disconnect-MgGraph | Out-Null
            Write-Host "Disconnected from Microsoft Graph." -ForegroundColor Yellow
        }
        else {
            Write-Host "No active Microsoft Graph session found." -ForegroundColor DarkYellow
        }
    }
    catch {
        Write-Host "Disconnect attempt completed." -ForegroundColor Yellow
    }
}

function Connect-GraphSession {
    Disconnect-GraphSession
    Write-Host "`nConnecting to Microsoft Graph..." -ForegroundColor Cyan
    try {
        Connect-MgGraph -Scopes @(
            'User.Read.All',
            'UserAuthenticationMethod.Read.All',
            'AuditLog.Read.All',
            'Policy.Read.All'
        ) -NoWelcome | Out-Null

        if (Get-MgContext) {
            Write-Host "Connected." -ForegroundColor Green
        }
        else {
            Write-Host "Connection did not complete." -ForegroundColor Red
        }
    }
    catch {
        Write-Host "Connection failed: $($_.Exception.Message)" -ForegroundColor Red
    }
}

function Test-GraphConnection {
    if (-not (Get-MgContext)) {
        Write-Host "Not connected to Microsoft Graph. Use option 1 first." -ForegroundColor Red
        return $false
    }
    return $true
}

# =========================
# TENANT SMS POLICY (queried once per run)
# =========================
function Get-TenantSmsPolicyState {
    $result = [PSCustomObject]@{
        SmsPolicyEnabled = $false
        SmsPolicyState   = 'Unknown'
    }

    try {
        $policy = Invoke-MgGraphRequest `
            -Method GET `
            -Uri "https://graph.microsoft.com/beta/policies/authenticationMethodsPolicy/authenticationMethodConfigurations/Sms" `
            -OutputType PSObject `
            -ErrorAction Stop

        $state = $null
        if ($policy.PSObject.Properties.Name -contains 'state') {
            $state = [string]$policy.state
        }
        elseif ($policy.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $policy.AdditionalProperties -and
                $policy.AdditionalProperties.ContainsKey('state')) {
            $state = [string]$policy.AdditionalProperties['state']
        }

        if (-not [string]::IsNullOrWhiteSpace($state)) {
            $result.SmsPolicyState   = $state
            $result.SmsPolicyEnabled = ($state -eq 'enabled')
        }
    }
    catch {
        $result.SmsPolicyState = 'Unavailable'
    }

    return $result
}

# =========================
function Get-SmsMfaCapability {
    param(
        $RegistrationRecord,
        [bool]$MobilePhoneRegisteredLive,
        [bool]$TenantSmsPolicyEnabled
    )

    $isMfaCapable    = Get-RegistrationBool -RegistrationRecord $RegistrationRecord -Lower 'isMfaCapable' -Pascal 'IsMfaCapable'
    $isMfaRegistered = Get-RegistrationBool -RegistrationRecord $RegistrationRecord -Lower 'isMfaRegistered' -Pascal 'IsMfaRegistered'

    $registeredMethods = Get-RegistrationMethods -RegistrationRecord $RegistrationRecord

    # Mobile-only matching. Office numbers are voice-only and are intentionally excluded.
    $mobileFromReport = Test-StringPatternMatch `
        -Values $registeredMethods `
        -Patterns @('mobilePhone', '^sms$')

    $mobilePhoneRegistered = ($MobilePhoneRegisteredLive -or $mobileFromReport)

    $smsMfaLikely = ($mobilePhoneRegistered -eq $true)

    return [PSCustomObject]@{
        IsMfaCapable          = $isMfaCapable
        IsMfaRegistered       = $isMfaRegistered
        MobilePhoneRegistered = $mobilePhoneRegistered
        SmsMfaLikelyAvailable = $smsMfaLikely
    }
}

function Get-UserPhoneMethods {
    param([Parameter(Mandatory = $true)][string]$UserId)
    try {
        return @(Get-MgUserAuthenticationPhoneMethod -UserId $UserId -ErrorAction Stop)
    }
    catch {
        return @()
    }
}

function Get-UserAuthMethodInventory {
    param(
        [Parameter(Mandatory = $true)][string]$UserId,
        [Parameter()][object[]]$PhoneMethods = @()
    )

    $methodNames      = [System.Collections.Generic.List[string]]::new()
    $modernSQ         = $false
    $mobileRegistered = $false

    try {
        $methods = @(Get-MgUserAuthenticationMethod -UserId $UserId -ErrorAction Stop)
        foreach ($method in $methods) {
            $odataType = $null
            if ($method.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $method.AdditionalProperties -and
                $method.AdditionalProperties.ContainsKey('@odata.type')) {
                $odataType = [string]$method.AdditionalProperties['@odata.type']
            }
            elseif ($method.PSObject.Properties.Name -contains '@odata.type') {
                $odataType = [string]$method.'@odata.type'
            }

            switch ($odataType) {
                '#microsoft.graph.microsoftAuthenticatorAuthenticationMethod'             { $methodNames.Add('Microsoft Authenticator') }
                '#microsoft.graph.passwordlessMicrosoftAuthenticatorAuthenticationMethod' { $methodNames.Add('Authenticator (passwordless)') }
                '#microsoft.graph.fido2AuthenticationMethod'                             { $methodNames.Add('FIDO2 security key') }
                '#microsoft.graph.windowsHelloForBusinessAuthenticationMethod'           { $methodNames.Add('Windows Hello for Business') }
                '#microsoft.graph.softwareOathAuthenticationMethod'                      { $methodNames.Add('Software OATH') }
                '#microsoft.graph.emailAuthenticationMethod'                             { $methodNames.Add('Email') }
                '#microsoft.graph.passwordAuthenticationMethod'                          { $methodNames.Add('Password') }
                '#microsoft.graph.temporaryAccessPassAuthenticationMethod'               { $methodNames.Add('Temporary Access Pass') }
                '#microsoft.graph.platformCredentialAuthenticationMethod'                { $methodNames.Add('Passkey (platform credential)') }
                '#microsoft.graph.securityQuestionAuthenticationMethod' {
                    $methodNames.Add('Security questions')
                    $modernSQ = $true
                }
                '#microsoft.graph.phoneAuthenticationMethod' {
                    # normalized below using Get-MgUserAuthenticationPhoneMethod
                }
            }
        }
    }
    catch {}

    foreach ($phone in @($PhoneMethods)) {
        $phoneType = $null

        if ($phone.PSObject.Properties.Name -contains 'PhoneType' -and $null -ne $phone.PhoneType) {
            $phoneType = [string]$phone.PhoneType
        }
        elseif ($phone.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $phone.AdditionalProperties -and
                $phone.AdditionalProperties.ContainsKey('phoneType')) {
            $phoneType = [string]$phone.AdditionalProperties['phoneType']
        }
        elseif ($script:PhoneTypeMap.ContainsKey([string]$phone.Id)) {
            $phoneType = $script:PhoneTypeMap[[string]$phone.Id]
        }

        switch ($phoneType) {
            'mobile' {
                $methodNames.Add('Phone call (mobile)')
                $mobileRegistered = $true
            }
            'alternateMobile' { $methodNames.Add('Phone call (alternate mobile)') }
            'office'          { $methodNames.Add('Phone call (office)') }
            default           { $methodNames.Add('Phone') }
        }
    }

    return [PSCustomObject]@{
        AllRegisteredAuthMethods = ($methodNames | Sort-Object -Unique) -join '; '
        ModernSecurityQuestion   = $modernSQ
        MobilePhoneRegistered    = $mobileRegistered
    }
}

function Get-PerUserMfaState {
    param([Parameter(Mandatory = $true)][string]$UserId)
    try {
        $req = Invoke-MgGraphRequest `
            -Method GET `
            -Uri "https://graph.microsoft.com/beta/users/$UserId/authentication/requirements" `
            -OutputType PSObject `
            -ErrorAction Stop
        if ($null -ne $req.perUserMfaState) {
            return [string]$req.perUserMfaState
        }
        return 'Unavailable'
    }
    catch {
        return 'Unavailable'
    }
}

function Get-TargetedUsers {
    param([Parameter(Mandatory = $true)][string[]]$UpnFilter)
    $users = [System.Collections.Generic.List[object]]::new()
    foreach ($upn in @($UpnFilter)) {
        try {
            $u = Get-MgUser -UserId $upn -Property Id,DisplayName,UserPrincipalName,Mail,AccountEnabled -ErrorAction Stop
            if ($null -ne $u) {
                $users.Add($u)
            }
        }
        catch {
            Write-Host "Unable to find user $upn : $($_.Exception.Message)" -ForegroundColor Yellow
        }
    }
    return @($users)
}

function Get-RegistrationLookup {
    param(
        [string]$Mode,
        [object[]]$Users,
        [string[]]$UpnFilter
    )

    $registrationLookup = @{}

    if ($Mode -eq 'Targeted' -and @($UpnFilter).Count -gt 0 -and @($Users).Count -gt 0) {
        foreach ($u in @($Users)) {
            try {
                $uri = "https://graph.microsoft.com/beta/reports/authenticationMethods/userRegistrationDetails/$($u.Id)"
                $detail = Invoke-MgGraphRequest -Method GET -Uri $uri -OutputType PSObject -ErrorAction Stop
                if ($null -ne $detail) {
                    $registrationLookup[$u.Id] = $detail
                }
            }
            catch {
                # continue if targeted user has no report row
            }
        }
    }
    else {
        $registrationReport = Get-MgReportAuthenticationMethodUserRegistrationDetail -All -ErrorAction Stop
        foreach ($r in $registrationReport) {
            $registrationLookup[$r.Id] = $r
        }
    }

    return $registrationLookup
}

function Export-AuditResults {
    param(
        [Parameter(Mandatory = $true)][object[]]$Results,
        [Parameter(Mandatory = $true)][string]$ModeLabel,
        [Parameter(Mandatory = $true)][ValidateSet('Enabled','All')][string]$AccountScope,
        [string[]]$DomainFilter = @(),
        [string[]]$UpnFilter = @()
    )

    if (-not (Test-Path $OutputFolder)) {
        New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
    }

    $timestamp = Get-Date -Format 'yyyyMMdd_HHmm'
    $safeModeLabel = $ModeLabel -replace '[^A-Za-z0-9]', ''
    $scopeLabel = if (@($UpnFilter).Count -gt 0) {
        'SpecificUPNs'
    }
    elseif (@($DomainFilter).Count -gt 0) {
        (($DomainFilter -join '_') -replace '[^A-Za-z0-9_\-]', '')
    }
    else {
        'AllDomains'
    }

    $baseName = "AuthAudit_${AccountScope}_${safeModeLabel}_${scopeLabel}_$timestamp"

    if ($UseExcel) {
        $xlsxPath = Join-Path $OutputFolder "$baseName.xlsx"
        $Results | Export-Excel `
            -Path $xlsxPath `
            -WorksheetName 'AuditResults' `
            -TableName ("AuthAudit{0}{1}" -f $AccountScope, $safeModeLabel) `
            -TableStyle Medium6 `
            -AutoSize `
            -FreezeTopRow `
            -BoldTopRow
    }
    else {
        $csvPath = Join-Path $OutputFolder "$baseName.csv"
        $Results | Export-Csv -Path $csvPath -NoTypeInformation -Encoding UTF8

        Write-Host "`nImportExcel module not found. Exported CSV: $csvPath" -ForegroundColor Yellow

        $txtPath = Join-Path $OutputFolder "$baseName.txt"
        $Results | Format-List * | Out-String -Width 4096 | Set-Content -Path $txtPath -Encoding UTF8
        Write-Host "Exported text: $txtPath" -ForegroundColor Green
    }
}

function Run-Audit {
    param(
        [ValidateSet('Sample','Full','Targeted')][string]$Mode,
        [ValidateSet('Enabled','All')][string]$AccountScope,
        [int]$SampleSize = 0,
        [string[]]$DomainFilter = @(),
        [string[]]$UpnFilter = @()
    )

    if (-not (Test-GraphConnection)) {
        return
    }

    $modeLabel = switch ($Mode) {
        'Sample'   { "Sample$SampleSize" }
        'Targeted' { 'TargetedUPN' }
        default    { 'Full' }
    }

    Write-Host "`nStarting $modeLabel audit for $AccountScope accounts..." -ForegroundColor Cyan

    if (@($UpnFilter).Count -gt 0) {
        Write-Host "UPN filter: $($UpnFilter -join ', ')" -ForegroundColor DarkCyan
    }
    elseif (@($DomainFilter).Count -gt 0) {
        Write-Host "Domain filter: $($DomainFilter -join ', ')" -ForegroundColor DarkCyan
    }
    else {
        Write-Host "Domain filter: All domains" -ForegroundColor DarkCyan
    }

    $tenantSms = Get-TenantSmsPolicyState
    Write-Host "Tenant SMS method policy state: $($tenantSms.SmsPolicyState)" -ForegroundColor DarkCyan

    Write-Progress -Activity "Preparing Audit" -Status "Retrieving users..." -PercentComplete 10

    try {
        if ($Mode -eq 'Targeted' -and @($UpnFilter).Count -gt 0) {
            $users = @(Get-TargetedUsers -UpnFilter $UpnFilter)
            if ($AccountScope -eq 'Enabled') {
                $users = @($users | Where-Object { $_.AccountEnabled -eq $true })
            }
        }
        else {
            $users = @(Get-MgUser -All -Property Id,DisplayName,UserPrincipalName,Mail,AccountEnabled -ErrorAction Stop)

            if ($AccountScope -eq 'Enabled') {
                $users = @($users | Where-Object { $_.AccountEnabled -eq $true })
            }

            if (@($DomainFilter).Count -gt 0) {
                $users = @($users | Where-Object {
                    $upnDomain = $null
                    if (-not [string]::IsNullOrWhiteSpace($_.UserPrincipalName) -and $_.UserPrincipalName -match '@') {
                        $upnDomain = ($_.UserPrincipalName.Split('@')[-1]).ToLowerInvariant()
                    }
                    $upnDomain -in $DomainFilter
                })
            }

            if (@($UpnFilter).Count -gt 0) {
                $users = @($users | Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_.UserPrincipalName) -and
                    $_.UserPrincipalName.ToLowerInvariant() -in $UpnFilter
                })
            }
        }
    }
    catch {
        Write-Host "Failed to retrieve users: $($_.Exception.Message)" -ForegroundColor Red
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    if ($Mode -eq 'Sample') {
        $users = @($users | Select-Object -First $SampleSize)
    }

    $total = @($users).Count
    if ($total -eq 0) {
        Write-Host "No users found to process." -ForegroundColor Yellow
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    Write-Progress -Activity "Preparing Audit" -Status "Retrieving authentication registration report..." -PercentComplete 25

    try {
        $registrationLookup = Get-RegistrationLookup -Mode $Mode -Users $users -UpnFilter $UpnFilter
    }
    catch {
        Write-Host "Failed to retrieve registration report: $($_.Exception.Message)" -ForegroundColor Red
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    $results = [System.Collections.Generic.List[object]]::new()
    $counter = 0

    foreach ($user in $users) {
        $counter++
        $percent = [math]::Round(25 + (($counter / $total) * 75), 0)

        Write-Progress `
            -Activity "Auditing Users ($AccountScope / $modeLabel)" `
            -Status "$counter of $total processed" `
            -PercentComplete $percent

        $reg = $null
        if ($registrationLookup.ContainsKey($user.Id)) {
            $reg = $registrationLookup[$user.Id]
        }

        try {
            $perUserMfa = Get-PerUserMfaState -UserId $user.Id
            $phones     = Get-UserPhoneMethods -UserId $user.Id
            $authInv    = Get-UserAuthMethodInventory -UserId $user.Id -PhoneMethods @($phones)
            $sqStatus   = Get-SecurityQuestionStatus -RegistrationRecord $reg -ModernSecurityQuestionFound $authInv.ModernSecurityQuestion
            $smsCap     = Get-SmsMfaCapability -RegistrationRecord $reg -MobilePhoneRegisteredLive $authInv.MobilePhoneRegistered -TenantSmsPolicyEnabled $tenantSms.SmsPolicyEnabled
        }
        catch {
            Write-Host "Failed processing $($user.UserPrincipalName): $($_.Exception.Message)" -ForegroundColor Red
            continue
        }

        if (-not $phones -or @($phones).Count -eq 0) {
            $results.Add([PSCustomObject]@{
                UserPrincipalName           = $user.UserPrincipalName
                Email                       = $user.Mail
                AccountEnabled              = $user.AccountEnabled
                Domain                      = $(if ($user.UserPrincipalName -match '@') { $user.UserPrincipalName.Split('@')[-1] } else { '' })
                PerUserMfaState             = $perUserMfa
                IsMfaRegistered             = $smsCap.IsMfaRegistered
                IsMfaCapable                = $smsCap.IsMfaCapable
                TenantSmsPolicyState        = $tenantSms.SmsPolicyState
                MobilePhoneRegistered       = $smsCap.MobilePhoneRegistered
                SmsMfaLikelyAvailable       = $smsCap.SmsMfaLikelyAvailable
                SecurityQuestionsRegistered = $sqStatus.SecurityQuestionsRegistered
                AllRegisteredAuthMethods    = $authInv.AllRegisteredAuthMethods
                PhoneType                   = 'None'
                PhoneNumber                 = ''
            })
        }
        else {
            foreach ($p in @($phones)) {
                $mapped = if ($script:PhoneTypeMap.ContainsKey([string]$p.Id)) {
                    $script:PhoneTypeMap[[string]$p.Id]
                }
                elseif ($p.PSObject.Properties.Name -contains 'PhoneType' -and $null -ne $p.PhoneType) {
                    [string]$p.PhoneType
                }
                else {
                    'Unknown'
                }

                $results.Add([PSCustomObject]@{
                    UserPrincipalName           = $user.UserPrincipalName
                    Email                       = $user.Mail
                    AccountEnabled              = $user.AccountEnabled
                    Domain                      = $(if ($user.UserPrincipalName -match '@') { $user.UserPrincipalName.Split('@')[-1] } else { '' })
                    PerUserMfaState             = $perUserMfa
                    IsMfaRegistered             = $smsCap.IsMfaRegistered
                    IsMfaCapable                = $smsCap.IsMfaCapable
                    TenantSmsPolicyState        = $tenantSms.SmsPolicyState
                    MobilePhoneRegistered       = $smsCap.MobilePhoneRegistered
                    SmsMfaLikelyAvailable       = $smsCap.SmsMfaLikelyAvailable
                    SecurityQuestionsRegistered = $sqStatus.SecurityQuestionsRegistered
                    AllRegisteredAuthMethods    = $authInv.AllRegisteredAuthMethods
                    PhoneType                   = $mapped
                    PhoneNumber                 = $p.PhoneNumber
                })
            }
        }
    }

    Write-Progress -Activity "Auditing Users" -Completed

    $sorted = @($results | Sort-Object UserPrincipalName, PhoneType)

    Export-AuditResults `
        -Results @($sorted) `
        -ModeLabel $modeLabel `
        -AccountScope $AccountScope `
        -DomainFilter $DomainFilter `
        -UpnFilter $UpnFilter

    Write-Host "`nAudit complete. Results exported." -ForegroundColor Green
}

function Show-AuditSubMenu {
    param([Parameter(Mandatory = $true)][ValidateSet('Enabled','All')][string]$AccountScope)

    while ($true) {
        Write-Host ""
        Write-Host "===== $AccountScope ACCOUNTS MENU =====" -ForegroundColor Cyan
        Write-Host "1. Sample Results (prompt for count)"
        Write-Host "2. Full Tenant Audit"
        Write-Host "3. Specific UPN(s)"
        Write-Host "B. Back"

        $subChoice = Read-Host "Select an option"

        switch ($subChoice.ToUpper()) {
            '1' {
                $sampleSize = Get-SampleSize
                $domainFilter = Get-DomainFilter
                Run-Audit -Mode 'Sample' -AccountScope $AccountScope -SampleSize $sampleSize -DomainFilter $domainFilter
            }
            '2' {
                $domainFilter = Get-DomainFilter
                Run-Audit -Mode 'Full' -AccountScope $AccountScope -DomainFilter $domainFilter
            }
            '3' {
                $upnFilter = Get-UpnFilter
                if (@($upnFilter).Count -gt 0) {
                    Run-Audit -Mode 'Targeted' -AccountScope $AccountScope -UpnFilter $upnFilter
                }
                else {
                    Write-Host "No UPNs entered." -ForegroundColor Yellow
                }
            }
            'B' {
                return
            }
            default {
                Write-Host "Invalid selection." -ForegroundColor Red
            }
        }
    }
}

# =========================
# MAIN MENU
# =========================
while ($true) {
    Write-Host "`n===== MAIN MENU =====" -ForegroundColor Cyan
    Write-Host "1. Disconnect / Reconnect Microsoft Graph"
    Write-Host "2. Audit Enabled Accounts"
    Write-Host "3. Audit All Accounts"
    Write-Host "Q. Quit"

    $choice = Read-Host "Select an option"

    switch ($choice.ToUpper()) {
        '1' { Connect-GraphSession }
        '2' { Show-AuditSubMenu -AccountScope 'Enabled' }
        '3' { Show-AuditSubMenu -AccountScope 'All' }
        'Q' {
            Disconnect-GraphSession
            Write-Host "Exiting..." -ForegroundColor Yellow
            break
        }
        default {
            Write-Host "Invalid selection." -ForegroundColor Red
        }
    }
}
