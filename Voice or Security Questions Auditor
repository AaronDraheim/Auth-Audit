param(
    [string]$OutputFolder = 'C:\Temp'
)

# =========================
# MODULES
# =========================
Import-Module Microsoft.Graph.Authentication -ErrorAction Stop
Import-Module Microsoft.Graph.Users -ErrorAction Stop
Import-Module Microsoft.Graph.Identity.SignIns -ErrorAction Stop
Import-Module Microsoft.Graph.Reports -ErrorAction Stop

# Optional Excel export support
$UseExcel = $false
try {
    if (Get-Module -ListAvailable -Name ImportExcel) {
        Import-Module ImportExcel -ErrorAction Stop
        $UseExcel = $true
    }
}
catch {
    $UseExcel = $false
}

# =========================
# CONSTANTS
# =========================
$script:PhoneTypeMap = @{
    '3179e48a-750b-4051-897c-87b9720928f7' = 'mobile'
    'b6332ec1-7057-4abe-9331-3d72feddfe41' = 'alternateMobile'
    'e37fc753-ff3b-4958-9484-eaa9425c82bc' = 'office'
}

# =========================
# FUNCTIONS
# =========================

function Disconnect-GraphSession {
    try {
        if (Get-MgContext) {
            Disconnect-MgGraph | Out-Null
            Write-Host "Disconnected from Microsoft Graph." -ForegroundColor Yellow
        }
        else {
            Write-Host "No active Microsoft Graph session found." -ForegroundColor DarkYellow
        }
    }
    catch {
        Write-Host "Disconnect attempt completed." -ForegroundColor Yellow
    }
}

function Connect-GraphSession {
    Disconnect-GraphSession

    Write-Host "`nConnecting to Microsoft Graph..." -ForegroundColor Cyan

    try {
        Connect-MgGraph -Scopes @(
            'User.Read.All',
            'UserAuthenticationMethod.Read.All',
            'AuditLog.Read.All',
            'Policy.Read.All'
        ) -NoWelcome | Out-Null

        $ctx = Get-MgContext
        if ($ctx) {
            Write-Host "Connected." -ForegroundColor Green
        }
        else {
            Write-Host "Connection did not complete." -ForegroundColor Red
        }
    }
    catch {
        Write-Host "Connection failed: $($_.Exception.Message)" -ForegroundColor Red
    }
}

function Test-GraphConnection {
    $ctx = Get-MgContext
    if (-not $ctx) {
        Write-Host "Not connected to Microsoft Graph. Use option 1 first." -ForegroundColor Red
        return $false
    }
    return $true
}

function Get-SecurityQuestionSignal {
    param(
        $RegistrationRecord,
        [bool]$ModernSecurityQuestionFound
    )

    if ($ModernSecurityQuestionFound) {
        return 'Modern security question object found'
    }
    elseif ($null -ne $RegistrationRecord -and $RegistrationRecord.IsSsprRegistered -eq $true) {
        return 'SSPR registered but no modern object (possible legacy)'
    }
    else {
        return 'No evidence found'
    }
}

function Resolve-AuthMethodName {
    param(
        [string]$Method
    )

    switch ($Method) {
        'push'                 { return 'Microsoft Authenticator notification' }
        'sms'                  { return 'SMS' }
        'voiceMobile'          { return 'Phone call (mobile)' }
        'voiceAlternateMobile' { return 'Phone call (alternate mobile)' }
        'voiceOffice'          { return 'Phone call (office)' }
        'oath'                 { return 'OATH token' }
        'unknownFutureValue'   { return 'Unknown future value' }
        'Unavailable'          { return 'Unavailable' }
        default                { return $Method }
    }
}

function Get-SampleSize {
    while ($true) {
        $inputValue = Read-Host "Enter number of users to sample"

        if ([string]::IsNullOrWhiteSpace($inputValue)) {
            Write-Host "A value is required." -ForegroundColor Red
            continue
        }

        $parsedValue = 0
        if ([int]::TryParse($inputValue, [ref]$parsedValue) -and $parsedValue -gt 0) {
            return $parsedValue
        }

        Write-Host "Enter a whole number greater than 0." -ForegroundColor Red
    }
}

function Export-AuditResults {
    param(
        [Parameter(Mandatory = $true)]
        [System.Collections.IEnumerable]$Results,

        [Parameter(Mandatory = $true)]
        [string]$ModeLabel,

        [Parameter(Mandatory = $true)]
        [ValidateSet('Enabled','All')]
        [string]$AccountScope
    )

    if (-not (Test-Path $OutputFolder)) {
        New-Item -Path $OutputFolder -ItemType Directory -Force | Out-Null
    }

    $timestamp = Get-Date -Format 'yyyyMMdd_HHmm'
    $safeModeLabel = $ModeLabel -replace '[^A-Za-z0-9]', ''
    $baseName = "AuthAudit_${AccountScope}_${safeModeLabel}_$timestamp"

    if ($UseExcel) {
        $xlsxPath = Join-Path $OutputFolder "$baseName.xlsx"

        $Results | Export-Excel `
            -Path $xlsxPath `
            -WorksheetName 'AuditResults' `
            -TableName ("AuthAudit{0}{1}" -f $AccountScope, $safeModeLabel) `
            -TableStyle Medium6 `
            -AutoSize `
            -FreezeTopRow `
            -BoldTopRow

        Write-Host "`nExported Excel: $xlsxPath" -ForegroundColor Green
    }
    else {
        $csvPath = Join-Path $OutputFolder "$baseName.csv"

        $Results | Export-Csv -Path $csvPath -NoTypeInformation -Encoding UTF8

        Write-Host "`nImportExcel module not found. Exported CSV instead: $csvPath" -ForegroundColor Yellow
    }

    $txtPath = Join-Path $OutputFolder "$baseName.txt"
    $Results | Format-List * | Out-String -Width 4096 | Set-Content -Path $txtPath -Encoding UTF8
    Write-Host "Exported text: $txtPath" -ForegroundColor Green
}

function Get-ModernSecurityQuestionPresence {
    param(
        [Parameter(Mandatory = $true)]
        [string]$UserId
    )

    $modernSQ = $false

    try {
        $methods = Get-MgUserAuthenticationMethod -UserId $UserId -ErrorAction Stop

        foreach ($method in $methods) {
            if ($method.PSObject.Properties.Name -contains 'AdditionalProperties') {
                if ($method.AdditionalProperties.'@odata.type' -eq '#microsoft.graph.securityQuestionAuthenticationMethod') {
                    $modernSQ = $true
                    break
                }
            }

            if ($method.PSObject.Properties.Name -contains '@odata.type') {
                if ($method.'@odata.type' -eq '#microsoft.graph.securityQuestionAuthenticationMethod') {
                    $modernSQ = $true
                    break
                }
            }
        }
    }
    catch {
        $modernSQ = $false
    }

    return $modernSQ
}

function Get-PerUserMfaState {
    param(
        [Parameter(Mandatory = $true)]
        [string]$UserId
    )

    try {
        $req = Invoke-MgGraphRequest `
            -Method GET `
            -Uri "https://graph.microsoft.com/beta/users/$UserId/authentication/requirements" `
            -OutputType PSObject `
            -ErrorAction Stop

        if ($null -ne $req.perUserMfaState) {
            return [string]$req.perUserMfaState
        }

        return 'Unavailable'
    }
    catch {
        return 'Unavailable'
    }
}

function Get-UserSignInMethodView {
    param(
        [Parameter(Mandatory = $true)]
        [string]$UserId
    )

    $result = [PSCustomObject]@{
        SignInMode              = 'Unknown'
        UserDefaultSignInMethod = 'Unavailable'
        SystemPreferredEnabled  = $null
    }

    try {
        $prefs = Invoke-MgGraphRequest `
            -Method GET `
            -Uri "https://graph.microsoft.com/beta/users/$UserId/authentication/signInPreferences" `
            -OutputType PSObject `
            -ErrorAction Stop

        $isSystemPreferred = $null
        $userMethod = $null

        if ($prefs.PSObject.Properties.Name -contains 'isSystemPreferredAuthenticationMethodEnabled') {
            $isSystemPreferred = $prefs.isSystemPreferredAuthenticationMethodEnabled
        }
        elseif ($prefs.PSObject.Properties.Name -contains 'IsSystemPreferredAuthenticationMethodEnabled') {
            $isSystemPreferred = $prefs.IsSystemPreferredAuthenticationMethodEnabled
        }
        elseif ($prefs.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $prefs.AdditionalProperties -and
                $prefs.AdditionalProperties.ContainsKey('isSystemPreferredAuthenticationMethodEnabled')) {
            $isSystemPreferred = $prefs.AdditionalProperties['isSystemPreferredAuthenticationMethodEnabled']
        }

        if ($prefs.PSObject.Properties.Name -contains 'userPreferredMethodForSecondaryAuthentication') {
            $userMethod = $prefs.userPreferredMethodForSecondaryAuthentication
        }
        elseif ($prefs.PSObject.Properties.Name -contains 'UserPreferredMethodForSecondaryAuthentication') {
            $userMethod = $prefs.UserPreferredMethodForSecondaryAuthentication
        }
        elseif ($prefs.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $prefs.AdditionalProperties -and
                $prefs.AdditionalProperties.ContainsKey('userPreferredMethodForSecondaryAuthentication')) {
            $userMethod = $prefs.AdditionalProperties['userPreferredMethodForSecondaryAuthentication']
        }

        if ($null -ne $isSystemPreferred) {
            $result.SystemPreferredEnabled = [bool]$isSystemPreferred
        }

        if (-not [string]::IsNullOrWhiteSpace([string]$userMethod)) {
            $result.UserDefaultSignInMethod = Resolve-AuthMethodName -Method ([string]$userMethod)
        }

        if ($isSystemPreferred -eq $true) {
            $result.SignInMode = 'SystemPreferred'
        }
        elseif ($null -ne $isSystemPreferred -and $isSystemPreferred -eq $false) {
            $result.SignInMode = 'UserPreferred'
        }
    }
    catch {
        # keep defaults
    }

    return $result
}

function Get-UserPhoneMethods {
    param(
        [Parameter(Mandatory = $true)]
        [string]$UserId
    )

    try {
        return @(Get-MgUserAuthenticationPhoneMethod -UserId $UserId -ErrorAction Stop)
    }
    catch {
        return @()
    }
}

function Run-Audit {
    param(
        [ValidateSet('Sample','Full')]
        [string]$Mode,

        [ValidateSet('Enabled','All')]
        [string]$AccountScope,

        [int]$SampleSize = 0
    )

    if (-not (Test-GraphConnection)) {
        return
    }

    $modeLabel = if ($Mode -eq 'Sample') { "Sample$SampleSize" } else { 'Full' }

    Write-Host "`nStarting $modeLabel audit for $AccountScope accounts..." -ForegroundColor Cyan
    Write-Progress -Activity "Preparing Audit" -Status "Retrieving authentication registration report..." -PercentComplete 5

    $registrationLookup = @{}
    try {
        $registrationReport = Get-MgReportAuthenticationMethodUserRegistrationDetail -All -ErrorAction Stop
        foreach ($r in $registrationReport) {
            $registrationLookup[$r.Id] = $r
        }
    }
    catch {
        Write-Host "Failed to retrieve registration report: $($_.Exception.Message)" -ForegroundColor Red
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    Write-Progress -Activity "Preparing Audit" -Status "Retrieving users..." -PercentComplete 15

    try {
        $users = @(Get-MgUser -All -Property Id,DisplayName,UserPrincipalName,Mail,AccountEnabled -ErrorAction Stop)

        if ($AccountScope -eq 'Enabled') {
            $users = $users | Where-Object { $_.AccountEnabled -eq $true }
        }
    }
    catch {
        Write-Host "Failed to retrieve users: $($_.Exception.Message)" -ForegroundColor Red
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    if ($Mode -eq 'Sample') {
        $users = $users | Select-Object -First $SampleSize
    }

    $total = @($users).Count
    if ($total -eq 0) {
        Write-Host "No users found to process." -ForegroundColor Yellow
        Write-Progress -Activity "Preparing Audit" -Completed
        return
    }

    $results = [System.Collections.Generic.List[object]]::new()
    $counter = 0

    foreach ($user in $users) {
        $counter++
        $percent = [math]::Round(15 + (($counter / $total) * 85), 0)

        Write-Progress `
            -Activity "Auditing Users ($AccountScope / $modeLabel)" `
            -Status "$counter of $total processed" `
            -PercentComplete $percent

        $reg = $null
        if ($registrationLookup.ContainsKey($user.Id)) {
            $reg = $registrationLookup[$user.Id]
        }

        $mfaState   = Get-PerUserMfaState -UserId $user.Id
        $phones     = Get-UserPhoneMethods -UserId $user.Id
        $modernSQ   = Get-ModernSecurityQuestionPresence -UserId $user.Id
        $signal     = Get-SecurityQuestionSignal -RegistrationRecord $reg -ModernSecurityQuestionFound $modernSQ
        $signInView = Get-UserSignInMethodView -UserId $user.Id

        if (-not $phones -or @($phones).Count -eq 0) {
            $results.Add([PSCustomObject]@{
                UserPrincipalName       = $user.UserPrincipalName
                Email                   = $user.Mail
                AccountEnabled          = $user.AccountEnabled
                PerUserMfaState         = $mfaState
                SignInMode              = $signInView.SignInMode
                UserDefaultSignInMethod = $signInView.UserDefaultSignInMethod
                SystemPreferredEnabled  = $signInView.SystemPreferredEnabled
                IsMfaRegistered         = if ($null -ne $reg) { $reg.IsMfaRegistered } else { $null }
                IsSsprRegistered        = if ($null -ne $reg) { $reg.IsSsprRegistered } else { $null }
                SecurityQuestionSignals = $signal
                PhoneType               = 'None'
                PhoneNumber             = ''
            })
        }
        else {
            foreach ($p in $phones) {
                $mapped = if ($script:PhoneTypeMap.ContainsKey([string]$p.Id)) {
                    $script:PhoneTypeMap[[string]$p.Id]
                }
                else {
                    'Unknown'
                }

                $results.Add([PSCustomObject]@{
                    UserPrincipalName       = $user.UserPrincipalName
                    Email                   = $user.Mail
                    AccountEnabled          = $user.AccountEnabled
                    PerUserMfaState         = $mfaState
                    SignInMode              = $signInView.SignInMode
                    UserDefaultSignInMethod = $signInView.UserDefaultSignInMethod
                    SystemPreferredEnabled  = $signInView.SystemPreferredEnabled
                    IsMfaRegistered         = if ($null -ne $reg) { $reg.IsMfaRegistered } else { $null }
                    IsSsprRegistered        = if ($null -ne $reg) { $reg.IsSsprRegistered } else { $null }
                    SecurityQuestionSignals = $signal
                    PhoneType               = $mapped
                    PhoneNumber             = $p.PhoneNumber
                })
            }
        }
    }

    Write-Progress -Activity "Auditing Users" -Completed

    $sorted = $results | Sort-Object UserPrincipalName, PhoneType
    Export-AuditResults -Results $sorted -ModeLabel $modeLabel -AccountScope $AccountScope

    Write-Host "`nAudit complete." -ForegroundColor Green
}

function Show-AuditSubMenu {
    param(
        [Parameter(Mandatory = $true)]
        [ValidateSet('Enabled','All')]
        [string]$AccountScope
    )

    while ($true) {
        Write-Host ""
        Write-Host "===== $AccountScope ACCOUNTS MENU =====" -ForegroundColor Cyan
        Write-Host "1. Sample Results (prompt for count)"
        Write-Host "2. Full Tenant Audit"
        Write-Host "B. Back"

        $subChoice = Read-Host "Select an option"

        switch ($subChoice.ToUpper()) {
            '1' {
                $sampleSize = Get-SampleSize
                Run-Audit -Mode 'Sample' -AccountScope $AccountScope -SampleSize $sampleSize
            }
            '2' {
                Run-Audit -Mode 'Full' -AccountScope $AccountScope
            }
            'B' {
                break
            }
            default {
                Write-Host "Invalid selection." -ForegroundColor Red
            }
        }
    }
}

# =========================
# MAIN MENU
# =========================
while ($true) {
    Write-Host "`n===== MAIN MENU =====" -ForegroundColor Cyan
    Write-Host "1. Disconnect / Reconnect Microsoft Graph"
    Write-Host "2. Audit Enabled Accounts"
    Write-Host "3. Audit All Accounts"
    Write-Host "Q. Quit"

    $choice = Read-Host "Select an option"

    switch ($choice.ToUpper()) {
        '1' {
            Connect-GraphSession
        }
        '2' {
            Show-AuditSubMenu -AccountScope 'Enabled'
        }
        '3' {
            Show-AuditSubMenu -AccountScope 'All'
        }
        'Q' {
            Disconnect-GraphSession
            Write-Host "Exiting..." -ForegroundColor Yellow
            break
        }
        default {
            Write-Host "Invalid selection." -ForegroundColor Red
        }
    }
}
