                    # Security questions are inventoried, but do not count toward MFA Ready.
                    $methodNames.Add('Security questions')
                    $countableMethodNames.Add('Security questions')
                    $modernSecurityQuestionFound = $true
                }
                '#microsoft.graph.phoneAuthenticationMethod' { }
            }
        }
    }
    catch { }

# Uses FIDO2/passkey data when available and preserves fallback lookups.
    if (-not $fido2Found) {
        try {
# Uses FIDO2/passkey data when available and preserves fallback lookups.
            $fido2Methods = @(Get-MgUserAuthenticationFido2Method -UserId $UserId -ErrorAction Stop)
# Uses FIDO2/passkey data when available and preserves fallback lookups.
            if (@($fido2Methods).Count -gt 0) {
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                $methodNames.Add('FIDO2 security key')
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                $countableMethodNames.Add('FIDO2 security key')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
