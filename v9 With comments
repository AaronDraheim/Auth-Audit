                $methodNames.Add('Phone call / SMS (mobile)')
# Looks up SMS policy status used in MFA readiness checks.
                $countableMethodNames.Add('Phone call / SMS (mobile)')
# Looks up SMS policy status used in MFA readiness checks.
                $mfaReadyMethodNames.Add('Phone call / SMS (mobile)')
