                $odataType = [string]$method.'@odata.type'
            }

# Main menu routes the selected audit action without changing execution flow.
            switch ($odataType) {
                '#microsoft.graph.microsoftAuthenticatorAuthenticationMethod' {
                    $methodNames.Add('Microsoft Authenticator')
                    $countableMethodNames.Add('Microsoft Authenticator')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Microsoft Authenticator')
                }
                '#microsoft.graph.passwordlessMicrosoftAuthenticatorAuthenticationMethod' {
                    $methodNames.Add('Authenticator (passwordless)')
                    $countableMethodNames.Add('Authenticator (passwordless)')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Authenticator (passwordless)')
                }
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                '#microsoft.graph.fido2AuthenticationMethod' {
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                    $methodNames.Add('FIDO2 security key')
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                    $countableMethodNames.Add('FIDO2 security key')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('FIDO2 security key')
# Uses FIDO2/passkey data when available and preserves fallback lookups.
                    $fido2Found = $true
                }
# Uses hardware OATH data when available and preserves fallback behavior.
                '#microsoft.graph.hardwareOathAuthenticationMethod' {
# Uses hardware OATH data when available and preserves fallback behavior.
                    $methodNames.Add('Hardware OATH token')
# Uses hardware OATH data when available and preserves fallback behavior.
                    $countableMethodNames.Add('Hardware OATH token')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Hardware OATH token')
# Uses hardware OATH data when available and preserves fallback behavior.
                    $hardwareOathFound = $true
                }
                '#microsoft.graph.windowsHelloForBusinessAuthenticationMethod' {
                    $methodNames.Add('Windows Hello for Business')
                    $countableMethodNames.Add('Windows Hello for Business')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Windows Hello for Business')
                }
# Uses hardware OATH data when available and preserves fallback behavior.
                '#microsoft.graph.softwareOathAuthenticationMethod' {
# Uses hardware OATH data when available and preserves fallback behavior.
                    $methodNames.Add('Software OATH')
# Uses hardware OATH data when available and preserves fallback behavior.
                    $countableMethodNames.Add('Software OATH')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Software OATH')
                }
                '#microsoft.graph.emailAuthenticationMethod' {
                    $methodNames.Add('Email')
                    $countableMethodNames.Add('Email')
                }
                '#microsoft.graph.temporaryAccessPassAuthenticationMethod' {
                    $methodNames.Add('Temporary Access Pass')
                    $countableMethodNames.Add('Temporary Access Pass')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                    $mfaReadyMethodNames.Add('Temporary Access Pass')
                }
                '#microsoft.graph.platformCredentialAuthenticationMethod' {
