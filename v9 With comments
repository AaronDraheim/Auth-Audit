                $methodNames.Add('Phone')
                $countableMethodNames.Add('Phone')
            }
        }
    }

    $uniqueCountableMethods = @($countableMethodNames | Sort-Object -Unique)
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
    $uniqueMfaReadyMethods = @($mfaReadyMethodNames | Sort-Object -Unique)

    return [PSCustomObject]@{
        AllRegisteredAuthMethods          = ($methodNames | Sort-Object -Unique) -join '; '
        ModernSecurityQuestion           = $modernSecurityQuestionFound
