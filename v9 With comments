                $countableMethodNames.Add('Hardware OATH token')
# Calculates MFA Ready from supported methods; intentional exclusions remain unchanged.
                $mfaReadyMethodNames.Add('Hardware OATH token')
            }
        }
        catch { }
    }

# Summarizes registered phone methods for reporting.
    foreach ($phone in @($PhoneMethods)) {
# Maps Microsoft Graph phone method GUIDs to readable phone types.
        $phoneType = $null
# Maps Microsoft Graph phone method GUIDs to readable phone types.
        if ($phone.PSObject.Properties.Name -contains 'PhoneType' -and $null -ne $phone.PhoneType) {
# Maps Microsoft Graph phone method GUIDs to readable phone types.
            $phoneType = [string]$phone.PhoneType
        }
        elseif ($phone.PSObject.Properties.Name -contains 'AdditionalProperties' -and
                $null -ne $phone.AdditionalProperties -and
# Maps Microsoft Graph phone method GUIDs to readable phone types.
                $phone.AdditionalProperties.ContainsKey('phoneType')) {
# Maps Microsoft Graph phone method GUIDs to readable phone types.
            $phoneType = [string]$phone.AdditionalProperties['phoneType']
        }
# Maps Microsoft Graph phone method GUIDs to readable phone types.
        elseif ($script:PhoneTypeMap.ContainsKey([string]$phone.Id)) {
# Maps Microsoft Graph phone method GUIDs to readable phone types.
            $phoneType = $script:PhoneTypeMap[[string]$phone.Id]
        }

# Maps Microsoft Graph phone method GUIDs to readable phone types.
        switch ($phoneType) {
            'mobile' {
