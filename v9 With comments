    }

# Uses hardware OATH data when available and preserves fallback behavior.
    if (-not $hardwareOathFound) {
        try {
# Uses hardware OATH data when available and preserves fallback behavior.
            $hardwareOathResponse = Invoke-MgGraphRequest -Method GET -Uri "https://graph.microsoft.com/beta/users/$UserId/authentication/hardwareOathMethods" -OutputType PSObject -ErrorAction Stop
# Uses hardware OATH data when available and preserves fallback behavior.
            $hardwareOathMethods = @()
# Uses hardware OATH data when available and preserves fallback behavior.
            if ($null -ne $hardwareOathResponse.value) { $hardwareOathMethods = @($hardwareOathResponse.value) }
# Uses hardware OATH data when available and preserves fallback behavior.
            elseif ($null -ne $hardwareOathResponse) { $hardwareOathMethods = @($hardwareOathResponse) }

# Uses hardware OATH data when available and preserves fallback behavior.
            if (@($hardwareOathMethods).Count -gt 0) {
